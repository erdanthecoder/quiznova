{
  "name": "quoldek",
  "productName": "Quoldek",
  "version": "4.0.0",
  "description": "Classroom quiz software for teachers: write or paste a quiz, put it on the board, and the class answers on their own devices. Runs entirely on this computer, so a lesson works with no internet.",
  "main": "main.js",
  "author": "Quoldek",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "32.2.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "app.quoldek.desktop",
    "productName": "Quoldek",
    "copyright": "Quoldek",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "games.js",
      "store.js",
      "ops.js",
      "settings.js",
      "ui/**/*",
      "build/icon.png",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../static",
        "to": "app/static"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Quoldek-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quoldek",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Quoldek-Setup-${version}.exe",
      "menuCategory": "Education"
    },
    "linux": {
      "category": "Education",
      "synopsis": "Classroom quiz software for teachers"
    },
    "mac": {
      "category": "public.app-category.education"
    }
  },
  "keywords": [
    "education",
    "classroom",
    "teaching",
    "quiz",
    "assessment",
    "school",
    "learning"
  ]
}
