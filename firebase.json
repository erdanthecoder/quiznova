          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "**",
          "destination": "https://quoldek.web.app/student",
          "type": 302
        }
      ]
    }
  ]
}
